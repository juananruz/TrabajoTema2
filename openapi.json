{
    "openapi": "3.0.0",
    "info": {
        "title": "API Deportes JWT",
        "description": "API REST de deportes y autenticación con Access y Refresh Token.",
        "version": "1.0.0"
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "example": "Carlos"
                    },
                    "password": {
                        "type": "string",
                        "example": "jose"
                    }
                },
                "required": [
                    "nombre",
                    "password"
                ]
            },
            "LoginResponse": {
                "type": "object",
                "properties": {
                    "accessToken": {
                        "type": "string"
                    },
                    "refreshToken": {
                        "type": "string"
                    }
                },
                "required": [
                    "accessToken",
                    "refreshToken"
                ]
            },
            "RefreshRequest": {
                "type": "object",
                "properties": {
                    "refreshToken": {
                        "type": "string"
                    }
                },
                "required": [
                    "refreshToken"
                ]
            },
            "Deporte": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 0
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Fútbol"
                    },
                    "caloriasHora": {
                        "type": "number",
                        "example": 600
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "caloriasHora"
                ]
            },
            "DeporteInput": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "example": "Baloncesto"
                    },
                    "caloriasHora": {
                        "type": "number",
                        "example": 650
                    }
                },
                "required": [
                    "nombre",
                    "caloriasHora"
                ]
            },
            "MessageResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "message"
                ]
            }
        }
    },
    "paths": {
        "/api/register": {
            "post": {
                "summary": "Registrar nuevo usuario en el sistema",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Usuario registrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "summary": "Iniciar sesión y obtener tokens",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/components/schemas/LoginResponse"
                                        },
                                        {
                                            "$ref": "#/components/schemas/MessageResponse"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/refresh": {
            "post": {
                "summary": "Renovar token de acceso",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RefreshRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Nuevo token generado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "summary": "Cerrar sesión activa",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "Sesión cerrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/deportes": {
            "get": {
                "summary": "Obtener catálogo de deportes",
                "tags": [
                    "Deportes"
                ],
                "responses": {
                    "200": {
                        "description": "Lista de deportes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Deporte"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Registrar un nuevo deporte",
                "tags": [
                    "Deportes"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DeporteInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Deporte creado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Deporte"
                                            }
                                        },
                                        {
                                            "$ref": "#/components/schemas/MessageResponse"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/deportes/{id}": {
            "get": {
                "summary": "Buscar deporte por ID",
                "tags": [
                    "Deportes"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 0
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Deporte encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/components/schemas/Deporte"
                                        },
                                        {
                                            "$ref": "#/components/schemas/MessageResponse"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Modificar datos de un deporte",
                "tags": [
                    "Deportes"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 0
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DeporteInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Deporte actualizado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Deporte"
                                            }
                                        },
                                        {
                                            "$ref": "#/components/schemas/MessageResponse"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Eliminar un deporte",
                "tags": [
                    "Deportes"
                ],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 0
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Deporte eliminado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Deporte"
                                            }
                                        },
                                        {
                                            "$ref": "#/components/schemas/MessageResponse"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}